{% extends "@Contao/content_element/_base.html.twig" %}

{# Eine leere Wertzelle macht die Zeile zur Gruppenzeile (retro-table.css),
   deshalb darf zwischen <td> und </td> kein Leerzeichen stehen.
   Kein |nl2br: Es maskiert vorab und zeigt gespeicherte Entities (&quot;) dann wörtlich. #}
{% block content %}
  {% if steckbrief_entwurf %}
    <p class="steckbrief-entwurf">Entwurf: Dieses Gerät ist noch nicht veröffentlicht.</p>
  {% endif %}
  <div class="retro-table steckbrief">
    <table>
      <tbody>
        {% for gruppe in steckbrief_gruppen %}
          <tr><th scope="rowgroup">{{ gruppe.titel }}</th><td></td></tr>
          {% for zeile in gruppe.zeilen %}
            <tr><th scope="row">{{ zeile.label }}</th><td>{% for teil in zeile.wert|split("\n") %}{{ teil }}{% if not loop.last %}<br>{% endif %}{% endfor %}</td></tr>
          {% endfor %}
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endblock %}
